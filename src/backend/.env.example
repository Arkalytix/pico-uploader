# .env
# 將此檔案複製為 .env 並填入你自己的值

# 用於 API 驗證的靜態 Bearer Token，請產生一個複雜的隨機字串
# 例如用 openssl rand -hex 32 產生
STATIC_BEARER_TOKEN="change-this-to-a-very-secure-random-string"

# 你的服務器對外的公開 URL，用於組合圖片連結，結尾不要加斜線
# 例如：https://images.your-domain.com
HOST_URL="http://localhost:8765"

# 自定義上傳目錄路徑（可選）
# 如果不設定，將使用預設路徑 $HOME/pico_uploads
# 例如：CUSTOM_UPLOAD_DIR="/root/WebImage/"
# CUSTOM_UPLOAD_DIR="/your/custom/path/"



# 如果要關閉輪詢
# 狀態查詢：GET /debug/config 顯示輪詢狀態
# 手動重新載入：POST /debug/reload-config
# curl -X POST \
#   -H "Authorization: Bearer your-token" \
#   https://images.yourdomain.com/debug/reload-config

# ENABLE_POLLING="false"

# 允許上傳的副檔名類型（用逗號分隔，不區分大小寫）
# 例如：ALLOWED_EXTENSIONS="jpg,jpeg,png,gif,webp,bmp"
ALLOWED_EXTENSIONS="jpg,jpeg,png,gif,webp,bmp,svg"

# 單檔上傳最大大小限制（MB）
# 設定為 -1 表示無限制
# 例如：MAX_FILE_SIZE_MB=10
MAX_FILE_SIZE_MB=10

# 上傳資料夾總使用空間限制（MB）
# 設定為 -1 表示無限制
# 例如：MAX_STORAGE_SIZE_MB=1000
MAX_STORAGE_SIZE_MB=1000
